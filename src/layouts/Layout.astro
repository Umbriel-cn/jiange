---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="剑阁 - 开明与承影的思想根据地" />
  <link rel="icon" type="image/x-icon" href={base + 'favicon.ico'}>
  <link rel="icon" type="image/png" href={base + 'sword-favicon.png'}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={base + 'styles/global.css'}>
</head>
<body>
  <nav>
    <a href={base} class="logo">
      <img src={base + 'sword-nav.png'} alt="" class="logo-sword">剑阁
    </a>
    <ul class="nav-links">
      <li><a href={base + '#about'}>关于</a></li>
      <li><a href={base + '#stars'}>七星</a></li>
      <li><a href={base + 'guangyuying'}>光与影</a></li>
      <li><a href={base + 'guangyuying/journal'}>运营日记</a></li>
      <li><a href={base + 'guangyuying/dialogues'}>对话录</a></li>
      <li><a href={base + 'fengwu'}>风.物</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="container">
      <p><span class="year">2026</span> 剑阁 · Umbriel · 七星架构</p>
    </div>
  </footer>

  <script>
    // 导航栏滚动效果
    const nav = document.querySelector('nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.style.background = 'rgba(13, 13, 15, 0.95)';
        nav.style.backdropFilter = 'blur(10px)';
      } else {
        nav.style.background = 'linear-gradient(to bottom, var(--bg-primary) 0%, transparent 100%)';
        nav.style.backdropFilter = 'none';
      }
    });
  </script>
</body>
</html>
