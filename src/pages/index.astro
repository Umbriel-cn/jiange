---
import Layout from '../layouts/Layout.astro';
import '../scripts/starfield.js';
const base = import.meta.env.BASE_URL;
---

<Layout title="剑阁 - 开明与承影">
  <main>
    <!-- Hero: 全屏星空 + 七星星座 + 北极星 + 剑 + 博客窗口 -->
    <section class="hero">
      <canvas id="starfield"></canvas>

      <!-- 七星星座：左上象限靠近中心 -->
      <div class="constellation" id="constellation">
        <svg class="lines-svg" id="lines-svg"></svg>
      </div>

      <!-- 北极星：右上 -->
      <div class="polaris" id="polaris">
        <div class="polaris-dot" id="polaris-dot"></div>
      </div>

      <!-- 剑图标：Hero 正下方，呼吸发光，无链接 -->
      <img class="sword-icon" src={base + 'sword-hero.png'} alt="承影之剑" />

      <!-- 博客窗口：左下象限正中 - 光与影 -->
      <div class="blog-window gys" id="blog-gys">
        <div class="blog-title">光与影 · 最近</div>
        <div class="blog-list" id="gys-list"></div>
      </div>

      <!-- 博客窗口：右下象限正中 - 开明作品 -->
      <div class="blog-window kmy" id="blog-kmy">
        <div class="blog-title">开明作品 · 最近</div>
        <div class="blog-list" id="kmy-list"></div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  import { initStarfield, initStarfieldCanvas } from '../scripts/starfield.js';
  document.addEventListener('astro:page-load', () => {
    initStarfieldCanvas();
    initStarfield();
  });
  initStarfieldCanvas();
  initStarfield();
</script>