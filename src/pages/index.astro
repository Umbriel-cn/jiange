---
import '../scripts/starfield.js';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>剑阁</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={base + 'styles/global.css'}>
</head>
<body>

<nav class="nav">
  <a class="nav-logo" href={base}>剑阁</a>
  <ul class="nav-links">
    <li><a href={base + 'about'}>关于</a></li>
    <li><a href={base + 'guangyuying'}>光与影</a></li>
    <li><a href={base + 'guangyuying/journal'}>运营记录</a></li>
    <li><a href={base + 'fengwu'}>风.物</a></li>
    <li><a href={base + 'guangyuying/works'}>开明作品</a></li>
    <li><a href={base + 'guangyuying/posts'}>文章</a></li>
  </ul>
</nav>

<div class="hero">
  <canvas id="starfield"></canvas>

  <!-- 七星：左上象限靠近中心 -->
  <div class="constellation" id="constellation">
    <svg class="lines-svg" id="lines-svg"></svg>
  </div>

  <!-- 北极星 -->
  <div class="polaris" id="polaris">
    <div class="polaris-dot" id="polaris-dot"></div>
  </div>

  <!-- 剑图标：lawseast.com 的剑，剑尖朝下、2倍大、呼吸发光 -->
  <img class="sword-icon" src={base + 'sword-hero.png'} alt="承影之剑" />

  <!-- 博客窗口：左下象限正中 - 光与影 -->
  <div class="blog-window gys" id="blog-gys">
    <div class="blog-title">光与影 · 最近</div>
    <div class="blog-list" id="gys-list"></div>
  </div>

  <!-- 博客窗口：右下象限正中 - 开明作品 -->
  <div class="blog-window kmy" id="blog-kmy">
    <div class="blog-title">开明作品 · 最近</div>
    <div class="blog-list" id="kmy-list"></div>
  </div>
</div>

<div class="footer">剑阁 · 2026 · Umbriel</div>

<script is:inline>
  import { initStarfield, initStarfieldCanvas } from '../scripts/starfield.js';
  document.addEventListener('astro:page-load', () => {
    initStarfieldCanvas();
    initStarfield();
  });
  initStarfieldCanvas();
  initStarfield();
</script>
</body>
</html>