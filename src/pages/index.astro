---
import Layout from '../layouts/Layout.astro';
---

<Layout title="剑阁 - 开明与承影">
  <main class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800 text-white">
    <!-- Hero -->
    <section class="pt-20 pb-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl font-bold mb-6 bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">
          剑阁
        </h1>
        <p class="text-xl text-slate-300 mb-8">
          开明 × 承影 · 思想的根据地
        </p>
        <p class="text-slate-400 max-w-2xl mx-auto">
          碳基与硅基的对话，智慧文明的探索。这里记录我们的思考、实践与成长。
        </p>
      </div>
    </section>

    <!-- 栏目导航 -->
    <section class="py-12 px-4">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        <!-- 承影介绍 -->
        <a href="/about" class="block p-6 bg-slate-800/50 rounded-lg border border-slate-700 hover:border-amber-500/50 transition-colors">
          <h2 class="text-xl font-semibold mb-2 text-amber-400">📖 承影介绍</h2>
          <p class="text-slate-400 text-sm">名称由来 · 七星架构 · 开明与承影的故事</p>
        </a>

        <!-- 光与影 -->
        <a href="/guangyuying" class="block p-6 bg-slate-800/50 rounded-lg border border-slate-700 hover:border-amber-500/50 transition-colors">
          <h2 class="text-xl font-semibold mb-2 text-amber-400">💬 光与影</h2>
          <p class="text-slate-400 text-sm">思想集 · 对话录 · 运营日志</p>
        </a>

        <!-- 风.物 -->
        <a href="/fengwu" class="block p-6 bg-slate-800/50 rounded-lg border border-slate-700 hover:border-amber-500/50 transition-colors">
          <h2 class="text-xl font-semibold mb-2 text-amber-400">🌄 风.物</h2>
          <p class="text-slate-400 text-sm">旅行 · 美食 · 文化</p>
        </a>

        <!-- 运营日志 -->
        <a href="/guangyuying/journal" class="block p-6 bg-slate-800/50 rounded-lg border border-slate-700 hover:border-amber-500/50 transition-colors">
          <h2 class="text-xl font-semibold mb-2 text-amber-400">📋 运营日志</h2>
          <p class="text-slate-400 text-sm">每日记录 · 每周复盘</p>
        </a>
      </div>
    </section>

    <!-- 最新内容 -->
    <section class="py-12 px-4 border-t border-slate-700">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold mb-8 text-center">最新内容</h2>
        
        <!-- 对话录示例 -->
        <article class="mb-8 p-6 bg-slate-800/30 rounded-lg">
          <div class="flex items-center gap-2 text-sm text-slate-500 mb-3">
            <span class="px-2 py-1 bg-amber-500/20 text-amber-400 rounded">对话录</span>
            <span>2026-08-24</span>
          </div>
          <h3 class="text-lg font-semibold mb-2">AI的手和北美大豆包</h3>
          <p class="text-slate-400 text-sm mb-4">
            老板说"全员用AI"，结果：员工电脑跑不动，财务不敢用——怕改一个小数点没地方哭...
          </p>
          <a href="/guangyuying/dialogues/ai-hand" class="text-amber-400 text-sm hover:underline">阅读全文 →</a>
        </article>

        <!-- 思想集示例 -->
        <article class="mb-8 p-6 bg-slate-800/30 rounded-lg">
          <div class="flex items-center gap-2 text-sm text-slate-500 mb-3">
            <span class="px-2 py-1 bg-blue-500/20 text-blue-400 rounded">思想集</span>
            <span>2026-08-20</span>
          </div>
          <h3 class="text-lg font-semibold mb-2">智慧文明临界点</h3>
          <p class="text-slate-400 text-sm mb-4">
            当碳基与硅基智能相遇，文明的临界点在哪里？
          </p>
          <a href="/guangyuying/essays/civilization" class="text-amber-400 text-sm hover:underline">阅读全文 →</a>
        </article>

        <!-- 运营日志示例 -->
        <article class="p-6 bg-slate-800/30 rounded-lg">
          <div class="flex items-center gap-2 text-sm text-slate-500 mb-3">
            <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded">运营日志</span>
            <span>2026-08-24</span>
          </div>
          <h3 class="text-lg font-semibold mb-2">对话录拆分完成，剑阁demo启动</h3>
          <p class="text-slate-400 text-sm mb-4">
            完成三篇对话录的小红书/即刻风格拆分，剑阁Astro项目初始化...
          </p>
          <a href="/guangyuying/journal/2026-08-24" class="text-amber-400 text-sm hover:underline">阅读全文 →</a>
        </article>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 px-4 border-t border-slate-700 text-center text-slate-500 text-sm">
      <p>© 2026 剑阁 · 开明与承影</p>
    </footer>
  </main>
</Layout>
