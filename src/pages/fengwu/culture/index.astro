---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="文化 - 风.物">
  <main class="min-h-screen bg-gradient-to-b from-slate-900 to-slate-800 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <a href="/jiange/fengwu" class="text-purple-400 hover:underline mb-8 inline-block flex items-center gap-1">← 返回风.物</a>
      
      <header class="mb-12 text-center">
        <h1 class="text-4xl font-bold mb-4 text-purple-400">文化</h1>
        <p class="text-slate-400 text-lg">触摸历史的温度，感受文明的脉搏。</p>
      </header>

      <div class="space-y-8">
        <p class="text-slate-400 text-center py-8">内容建设中...</p>
      </div>
    </div>
  </main>
</Layout>
